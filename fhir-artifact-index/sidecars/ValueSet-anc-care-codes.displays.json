{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/anc/ValueSet-anc-care-codes.displays.json",
  "title": "ANC Care Codes Display Values",
  "description": "Display values for ANC Care Codes ValueSet codes. Generated from FHIR expansions. Keys are code fragments (the part after '#' in the canonical IRI). The full IRI can be reconstructed as system + '#' + code.",
  "type": "object",
  "properties": {
    "fhir:displays": {
      "type": "object",
      "description": "Multilingual display values for ValueSet codes keyed by code fragment",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "description": "Display values for a specific code fragment by language",
          "properties": {
            "en": {
              "type": "string",
              "description": "English display value"
            }
          },
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "string",
              "description": "Display value in the specified language (ISO 639-1 code)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fhir:displays"
  ],
  "additionalProperties": true,
  "fhir:displays": {
    "ANC.Case": {
      "en": "Antenatal care case"
    },
    "ANC.Contact": {
      "en": "Antenatal care contact"
    },
    "ANC.Pregnancy": {
      "en": "Pregnancy condition"
    },
    "ANC.IronSupplement": {
      "en": "Iron supplement"
    },
    "ANC.FolicAcidSupplement": {
      "en": "Folic acid supplement"
    }
  },
  "fhir:valueSet": "http://smart.who.int/anc/ValueSet/anc-care-codes",
  "fhir:version": "0.3.0",
  "fhir:expansionTimestamp": "2026-11-10T20:50:18+00:00"
}