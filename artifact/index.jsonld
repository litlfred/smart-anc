    {
      "@id": "Questionnaire-ANCA.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCA",
      "dcterms:title": "ANC.A. Registration",
      "dcterms:description": "The registration process performed to identify and register a pregnant woman so that she can proceed to the antenatal care consultation.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCA"
      }
    },
    {
      "@id": "Questionnaire-ANCB10.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCB10",
      "dcterms:title": "ANC.B10 Counselling & treatment",
      "dcterms:description": "Based on the previous steps, health worker provides counselling for potential risk, behaviours and diagnoses, as well as preventive services and any treatment that can be provided at the facility, including through admission to a different part of the facility.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCB10"
      }
    },
    {
      "@id": "Questionnaire-ANCB11.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCB11",
      "dcterms:title": "ANC.B11 Referral needed?",
      "dcterms:description": "If there are any diagnoses requiring referral or services that cannot be provided at the facility, health worker refers pregnant woman based on findings during counselling.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCB11"
      }
    },
    {
      "@id": "Questionnaire-ANCB12.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCB12",
      "dcterms:title": "ANC.B12 Scheduling",
      "dcterms:description": "If a referral is not required, health worker schedules follow-up contact.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCB12"
      }
    },
    {
      "@id": "Questionnaire-ANCB4.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCB4",
      "dcterms:title": "ANC.B4 Confirm pregnancy",
      "dcterms:description": "Confirm the woman is pregnant using a urine dipstick test or by a blood test.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCB4"
      }
    },
    {
      "@id": "Questionnaire-ANCB5.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCB5",
      "dcterms:title": "ANC.B5 Quick check",
      "dcterms:description": "Health worker assesses woman to see whether there are any danger signs that warrant in-facility management or referral, or if possible, to proceed with the routine ANC contact.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCB5"
      }
    },
    {
      "@id": "Questionnaire-ANCB6.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCB6",
      "dcterms:title": "ANC.B6 Profile",
      "dcterms:description": "If this is the woman’s first ANC contact, the health worker records information on her current pregnancy, past medical and obstetric history, medications, behaviour, immunization status and other background information.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCB6"
      }
    },
    {
      "@id": "Questionnaire-ANCB7.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCB7",
      "dcterms:title": "ANC.B7 Symptoms & Follow-up",
      "dcterms:description": "Health worker follows up on any previously reported behaviours, medications and symptoms. Steps 8–10 below are all conducted within the ANC assessment.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCB7"
      }
    },
    {
      "@id": "Questionnaire-ANCB8.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCB8",
      "dcterms:title": "ANC.B8 Physical exam",
      "dcterms:description": "Health worker conducts a physical exam for weight, height (if first contact), maternal exam and fetal assessment.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCB8"
      }
    },
    {
      "@id": "Questionnaire-ANCB9.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCB9",
      "dcterms:title": "ANC.B9 Lab tests & imaging",
      "dcterms:description": "Health worker orders or follows up on required laboratory tests and ultrasound, as necessary. Health worker informs woman of all tests ordered and explains why.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCB9"
      }
    },
    {
      "@id": "Questionnaire-ANCC.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCC",
      "dcterms:title": "ANC.C. Referral",
      "dcterms:description": "An antenatal care referral to provide timely and appropriate referrals to a higher-level facility or health-care provider.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCC"
      }
    },
    {
      "@id": "Questionnaire-ANCEnd.jsonld",
      "@type": "fhir:Questionnaire",
      "dcterms:identifier": "Questionnaire/ANCEnd",
      "dcterms:title": "ANC.End End",
      "dcterms:description": "Closing the antenatal care record",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Questionnaire/ANCEnd"
      }
    },
