      "@id": "Library-ANCDT01.jsonld",
      "@type": "fhir:Library",
      "dcterms:identifier": "Library/ANCDT01",
      "dcterms:title": "ANC.DT.01 Danger signs",
      "dcterms:description": "Before each contact, during the Quick Check, the health worker should check whether the woman has any of the danger signs listed here – if yes, she should be referred to the hospital urgently; if no, the normal contact should be continued as normal",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Library/ANCDT01"
      }
    },
    {
      "@id": "Library-ANCDT02.jsonld",
      "@type": "fhir:Library",
      "dcterms:identifier": "Library/ANCDT02",
      "dcterms:title": "ANC.DT.02 Adolescent HEADSS asessement",
      "dcterms:description": "If client is an adolescent, conduct Home-Eating-Activity-Drugs-Sexuality-Safety-Suicide (HEADSS) assessment",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Library/ANCDT02"
      }
    },
