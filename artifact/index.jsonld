      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Library/ANCDT04"
      }
    },
    {
      "@id": "Library-ANCDT05.jsonld",
      "@type": "fhir:Library",
      "dcterms:identifier": "Library/ANCDT05",
      "dcterms:title": "ANC.DT.05 Evaluating labour",
      "dcterms:description": "During a cervical exam, if cervical dilation is greater than 2 cm evaluate the possibility of labour",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Library/ANCDT05"
      }
    },
    {
      "@id": "Library-ANCDT06.jsonld",
