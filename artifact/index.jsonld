      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Library/ANCDT06"
      }
    },
    {
      "@id": "Library-ANCDT07.jsonld",
      "@type": "fhir:Library",
      "dcterms:identifier": "Library/ANCDT07",
      "dcterms:title": "ANC.DT.07 Ultrasound recommendation",
      "dcterms:description": "An ultrasound is recommended for all pregnant women before 24 weeks of gestation (early ultrasound). If there's no ultrasound available at that health-carte facility, the woman should be referred to another facility in which she can receive an ultrasound.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Library/ANCDT07"
      }
    },
