  "@type": "fhir:ImplementationGuide",
  "dcterms:identifier": "smart.who.int.anc",
  "schema:version": "0.3.0",
  "schema:sameAs": {
    "@id": "http://smart.who.int/anc"
  },
  "dcterms:title": "WHO Antenatal Care Guideline Implementation Guide",
  "schema:numberOfItems": 1434,
  "schema:hasPart": [
    {
      "@id": "ActivityDefinition-ANCB10.jsonld",
      "@type": "fhir:ActivityDefinition",
      "dcterms:identifier": "ActivityDefinition/ANCB10",
      "dcterms:title": "ANC.B10 Counselling, in-facility management and treatment",
      "dcterms:description": "Based on the previous steps, health worker provides counselling for potential risk, behaviours and diagnoses, as well as preventive services and any treatment that can be provided at the facility, including through admission to a different part of the facility.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/ActivityDefinition/ANCB10"
      }
    },
    {
      "@id": "ActivityDefinition-ANCB11.jsonld",
      "@type": "fhir:ActivityDefinition",
      "dcterms:identifier": "ActivityDefinition/ANCB11",
      "dcterms:title": "ANC.B11 Referral needed?",
      "dcterms:description": "If there are any diagnoses requiring referral or services that cannot be provided at the facility, health worker refers pregnant woman based on findings during counselling.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/ActivityDefinition/ANCB11"
      }
    },
    {
      "@id": "ActivityDefinition-ANCB12.jsonld",
      "@type": "fhir:ActivityDefinition",
      "dcterms:identifier": "ActivityDefinition/ANCB12",
      "dcterms:title": "ANC.B12 Scheduling",
      "dcterms:description": "If a referral is not required, health worker schedules follow-up contact.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/ActivityDefinition/ANCB12"
      }
    },
    {
      "@id": "ActivityDefinition-ANCB4.jsonld",
      "@type": "fhir:ActivityDefinition",
      "dcterms:identifier": "ActivityDefinition/ANCB4",
      "dcterms:title": "ANC.B4 Confirm pregnancy",
      "dcterms:description": "Confirm the woman is pregnant using a urine dipstick test or by a blood test.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/ActivityDefinition/ANCB4"
      }
    },
    {
      "@id": "ActivityDefinition-ANCB5.jsonld",
      "@type": "fhir:ActivityDefinition",
      "dcterms:identifier": "ActivityDefinition/ANCB5",
      "dcterms:title": "ANC.B5 Quick check",
      "dcterms:description": "Health worker assesses woman to see whether there are any danger signs that warrant in-facility management or referral, or if possible, to proceed with the routine ANC contact.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/ActivityDefinition/ANCB5"
      }
    },
    {
      "@id": "ActivityDefinition-ANCB6.jsonld",
      "@type": "fhir:ActivityDefinition",
      "dcterms:identifier": "ActivityDefinition/ANCB6",
      "dcterms:title": "ANC.B6 Collect woman's profile and history",
      "dcterms:description": "If this is the woman’s first ANC contact, the health worker records information on her current pregnancy, past medical and obstetric history, medications, behaviour, immunization status and other background information.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/ActivityDefinition/ANCB6"
      }
    },
    {
      "@id": "ActivityDefinition-ANCB7.jsonld",
      "@type": "fhir:ActivityDefinition",
      "dcterms:identifier": "ActivityDefinition/ANCB7",
      "dcterms:title": "ANC.B7 Check symptoms and follow up",
      "dcterms:description": "Health worker follows up on any previously reported behaviours, medications and symptoms. Steps 8–10 below are all conducted within the ANC assessment.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/ActivityDefinition/ANCB7"
      }
    },
    {
      "@id": "ActivityDefinition-ANCB8.jsonld",
      "@type": "fhir:ActivityDefinition",
      "dcterms:identifier": "ActivityDefinition/ANCB8",
      "dcterms:title": "ANC.B8 Conduct physical exam",
      "dcterms:description": "Health worker conducts a physical exam for weight, height (if first contact), maternal exam and fetal assessment.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/ActivityDefinition/ANCB8"
      }
    },
    {
      "@id": "ActivityDefinition-ANCB9.jsonld",
      "@type": "fhir:ActivityDefinition",
      "dcterms:identifier": "ActivityDefinition/ANCB9",
      "dcterms:title": "ANC.B9 Conduct laboratory test and imaging",
      "dcterms:description": "Health worker orders or follows up on required laboratory tests and ultrasound, as necessary. Health worker informs woman of all tests ordered and explains why.",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/ActivityDefinition/ANCB9"
      }
    },
