      "dcterms:title": "ANC.DT.38 Deworming and malaria prophylaxis",
      "dcterms:description": "IF the woman is currently in a malaria-endemic setting, or in an area where there is greater than 20% prevalence of infection with any soil-transmitted helminths, THEN she should receive preventative treatment accordingly",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/PlanDefinition/ANCDT38"
      }
    },
