      "dcterms:description": "Depending on current and/or persistant symptoms, physiological symptoms counselling may be required",
      "dcterms:type": "Other",
      "schema:sameAs": {
        "@id": "http://smart.who.int/anc/Library/ANCDT03"
      }
    },
