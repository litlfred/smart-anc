Instance: ANCDT01-of-PlanDefinition
InstanceOf: PlanDefinition
Usage: #example
* id = "ANCDT01"
* contained = Inline-Instance-for-ANCDT01-1
* extension[0].url = "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
* extension[=].extension[0].url = "libraryName"
* extension[=].extension[=].valueString = "ANCContactDataElements"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "Danger signs"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n  @dataElement: ANC.B5.DE48 Danger signs\n  @activity: ANC.B5 Quick check\n  @description: Before each contact, the health worker should check whether the woman has any of the danger signs listed here – if yes, she should refer to the hospital urgently; if no, she should continue to the normal contact\n*/\ndefine \"Danger signs\":\n  [Observation: Cx.\"Danger signs\"] O\n    where O.status in { 'final', 'amended', 'corrected' }\n      and Coalesce(WC.ModifierExtension(O, 'who-notDone').value, false) is false\n      and Last(Split(O.encounter.reference, '/')) = Last(Split(encounter, '/'))\n    return O.value as FHIR.CodeableConcept"
* extension[=].extension[+].url = "displaySequence"
* extension[=].extension[=].valueInteger = 0
* extension[+].url = "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
* extension[=].extension[0].url = "libraryName"
* extension[=].extension[=].valueString = "ANCDT01"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "Should Proceed with ANC contact"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n\"Danger signs\" = \"No danger signs\"\n*/\ndefine \"Should Proceed with ANC contact\":\n  ContactData.\"Danger signs\" in Cx.\"Danger Signs - No danger signs Choices\""
* extension[=].extension[+].url = "displaySequence"
* extension[=].extension[=].valueInteger = 1
* extension[+].url = "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
* extension[=].extension[0].url = "libraryName"
* extension[=].extension[=].valueString = "ANCDT01"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "Should Proceed with ANC contact OR Referral"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n(((((((((((\"Danger signs\" = \"Bleeding vaginally\")\n  OR (\"Danger signs\" = \"Convulsing\"))\n  OR (\"Danger signs\" = \"Fever\"))\n  OR (\"Danger signs\" = \"Severe headache\"))\n  OR (\"Danger signs\" = \"Visual disturbance\"))\n  OR (\"Danger signs\" = \"Imminent delivery\"))\n  OR (\"Danger signs\" = \"Labour\"))\n  OR (\"Danger signs\" = \"Looks very ill\"))\n  OR (\"Danger signs\" = \"Severe vomiting\"))\n  OR (\"Danger signs\" = \"Severe pain\"))\n  OR (\"Danger signs\" = \"Severe abdominal pain\"))\n  OR (\"Danger signs\" = \"Unconscious\")\n*/\ndefine \"Should Proceed with ANC contact OR Referral\":\n  ContactData.\"Danger signs\" in Cx.\"Danger signs Choices\""
* extension[=].extension[+].url = "displaySequence"
