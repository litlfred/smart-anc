* extension[=].extension[=].valueString = "Should Conduct hepatitis C test"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n\"Population prevalence of hepatitis C\" ≥ 2%\n*/\ndefine \"Should Conduct hepatitis C test\":\n  Config.\"Population prevalence of hepatitis C\" >= 2 '%'"
