* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n\"Pregnancy confirmed\" = \"TRUE\"\n*/\ndefine \"Should Provide counselling on breastfeeding\":\n  ContactData.\"Pregnancy confirmed\" is true"
