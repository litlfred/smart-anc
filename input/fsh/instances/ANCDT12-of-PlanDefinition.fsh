* identifier.use = #official
* identifier.value = "ANC.DT.12"
* name = "ANCDT12"
* title = "ANC.DT.12 Urine testing"
* type = $plan-definition-type#eca-rule
* status = #active
* experimental = false
* date = "2025-06-24T13:58:48-06:00"
* description = "Conditions in which urine testing is required"
* useContext.code = $usage-context-type#task "Workflow Task"
* useContext.valueCodeableConcept = $activity-codes#ANC.B9. "Conduct laboratory tests and imaging"
* library = "http://smart.who.int/anc/Library/ANCDT12"
* action.title = "ANC.DT.12 Urine testing"
* action.trigger.type = #named-event
* action.trigger.name = "ANC.B9. Conduct laboratory tests and imaging"
* action.action[0].id = "1"
* action.action[=].title = "Conduct urine test"
* action.action[=].description = "Conduct urine test"
* action.action[=].textEquivalent = "Urine test is required any time the woman reports pain during urination (dysuria)"
* action.action[=].documentation.type = #citation
* action.action[=].documentation.label = "Managing complications guide (IMPAC) (2017): Section S-51 (3)"
* action.action[=].condition.kind = #applicability
* action.action[=].condition.expression.description = "\"Current physiological symptoms\" = \"Pain during urination (dysuria)\""
* action.action[=].condition.expression.language = #text/cql-identifier
* action.action[=].condition.expression.expression = "Should Conduct urine test"
* action.action[+].id = "2"
* action.action[=].title = "Do urine dipstick test for protein"
* action.action[=].description = "Do urine dipstick test for protein"
* action.action[=].textEquivalent = "Given high values (SBP ≥ 140 or DBP ≥ 90) upon second measure, urine dipstick test should be done to check for protein in the urine, a symptom of pre-eclampsia"
* action.action[=].documentation.type = #citation
* action.action[=].documentation.label = "Managing complications guide (IMPAC) (2017): Section S-51 (3)"
* action.action[=].condition.kind = #applicability
* action.action[=].condition.expression.description = "(\"Repeat systolic blood pressure\" ≥ 140 mmHg)\n  OR (\"Repeat diastolic blood pressure\" ≥ 90mmHg)"
* action.action[=].condition.expression.language = #text/cql-identifier
* action.action[=].condition.expression.expression = "Should Do urine dipstick test for protein"
* action.action[+].id = "3"
* action.action[=].title = "Conduct urine test"
* action.action[=].description = "Conduct urine test 2"
* action.action[=].textEquivalent = "The urine test checks for bacterial or other infections that can lead to adverse outcomes for the neonate. The urine dipstick test can check for proteins in the urine, which can be a sign of pre-eclampsia. Midstream urine culture is the preferred method for testing for asymptomatic bacteriuria (ASB) in pregnancy; if culture is not available, midstream urine Gram-staining is recommended over dipstick.\n\nUrine dipstick tests should only be used to diagnose ASB in pregnancy if midstream culture and Gram-staining are not possible. Dipstick tests are required to check for protein in the urine, a symptom of pre-eclampsia."
* action.action[=].documentation.type = #citation
* action.action[=].documentation.label = "WHO ANC recommendations (2016): B.1.2. Asymptomatic bacteriuria (ASB) (3)"
* action.action[=].condition.kind = #applicability
* action.action[=].condition.expression.description = "((\"ANC contact number\" = 1)\n  OR (\"Gestational age\" ≥ 26 weeks))\n  OR (\"Gestational age\" ≥ 34 weeks)"
* action.action[=].condition.expression.language = #text/cql-identifier
* action.action[=].condition.expression.expression = "Should Conduct urine test 2"