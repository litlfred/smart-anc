* action.action[+].id = "4"
* action.action[=].title = "Conduct hypertension counselling"
* action.action[=].description = "Conduct hypertension counselling"
* action.action[=].textEquivalent = "Woman has hypertension – SBP of 140 mmHg or higher and/or DBP of 90 mmHg or higher and no proteinuria.\n\nCounselling:\n– Advice to reduce workload and to rest\n– Advise on danger signs\n– Reassess at the next contact or in 1 week if 8 months pregnant\n– If hypertension persists after 1 week or at next contact, refer to hospital or discuss case with the doctor, if available"
* action.action[=].documentation.type = #citation
* action.action[=].documentation.label = "Pregnancy, childbirth, postpartum and newborn care guide (IMPAC) (2015): C3 (1)"
* action.action[=].condition.kind = #applicability
