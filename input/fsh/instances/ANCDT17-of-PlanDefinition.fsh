* action.action[=].title = "Refer urgently to a hospital"
* action.action[=].description = "Refer urgently to a hospital 3"
* action.action[=].textEquivalent = "Woman has severe hypertension. If SBP is 160 mmHg or higher and/or DBP is 110 mmHg or higher, then refer urgently to the hospital for further investigation and management."
