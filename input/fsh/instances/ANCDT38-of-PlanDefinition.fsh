* identifier.use = #official
* identifier.value = "ANC.DT.38"
* name = "ANCDT38"
* title = "ANC.DT.38 Deworming and malaria prophylaxis"
* type = $plan-definition-type#eca-rule
* status = #active
* experimental = false
* date = "2025-06-24T13:58:48-06:00"
* description = "IF the woman is currently in a malaria-endemic setting, or in an area where there is greater than 20% prevalence of infection with any soil-transmitted helminths, THEN she should receive preventative treatment accordingly"
* useContext.code = $usage-context-type#task "Workflow Task"
* useContext.valueCodeableConcept = $activity-codes#ANC.B10. "Counselling, in-facility management & treatment"
* library = "http://smart.who.int/anc/Library/ANCDT38"
* action.title = "ANC.DT.38 Deworming and malaria prophylaxis"
* action.trigger.type = #named-event
* action.trigger.name = "ANC.B10. Counselling, in-facility management and treatment"
* action.action[0].id = "1"
* action.action[=].title = "Provide malaria prophylaxis"
* action.action[=].description = "Provide malaria prophylaxis"
* action.action[=].textEquivalent = "Sleeping under an insecticide-treated bednet and the importance of seeking care and getting treatment as soon as she has any symptoms"
* action.action[=].documentation.type = #citation
* action.action[=].documentation.label = "WHO ANC recommendations (2016): C.6. Malaria prevention: intermittent preventive treatment in pregnancy (IPTp) (3)"
* action.action[=].condition.kind = #applicability
* action.action[=].condition.expression.description = "Malaria-endemic setting = TRUE"
* action.action[=].condition.expression.language = #text/cql-identifier
* action.action[=].condition.expression.expression = "Should Provide malaria prophylaxis"
* action.action[+].id = "2"
* action.action[=].title = "Do not give IPTp-SP, because woman is taking co-trimoxazole"
* action.action[=].description = "Do not give IPTp-SP, because woman is taking co-trimoxazole"
* action.action[=].textEquivalent = "IF the woman is currently taking co-trimoxazole, even in a malaria-endemic setting, she should not receive any dose of IPTp-SP. Women who are taking co-trimoxazole SHOULD NOT receive IPTp-SP. Taking both co-trimoxazole and IPTp-SP together can enhance side-effects, especially haematological side-effects such as anaemia."
* action.action[=].documentation.type = #citation
* action.action[=].documentation.label = "WHO ANC recommendations (2016): C.6. Malaria prevention: intermittent preventive treatment in pregnancy (IPTp) (3)"
* action.action[=].condition.kind = #applicability
* action.action[=].condition.expression.description = "(Malaria-endemic setting = TRUE)\n  AND (Current medications\" = \"Co-trimoxazole\")"
* action.action[=].condition.expression.language = #text/cql-identifier
* action.action[=].condition.expression.expression = "Should Do not give IPTp-SP, because woman is taking co-trimoxazole"
* action.action[+].id = "3"
* action.action[=].title = "Conduct deworming"
* action.action[=].description = "Conduct deworming"
* action.action[=].textEquivalent = "In areas with a population prevalence of infection with any soil-transmitted helminths of 20% or higher OR a population anaemia prevalence 40% or higher, preventive anthelminthic treatment is recommended for pregnant women after the first trimester as part of worm infection reduction programmes"
* action.action[=].documentation.type = #citation
* action.action[=].documentation.label = "WHO ANC recommendations (2016): C.4. Preventive anthelminthic treatment (3)"
* action.action[=].condition.kind = #applicability
* action.action[=].condition.expression.description = "(\"Population prevalence of soil-transmitted helminth infection\" ≥ 20% )\n  OR (\"Population prevalence of anaemia\" ≥ 40%)"
* action.action[=].condition.expression.language = #text/cql-identifier
* action.action[=].condition.expression.expression = "Should Conduct deworming"