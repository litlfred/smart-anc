* extension[=].extension[=].valueString = "Should Provide malaria prophylaxis"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\nMalaria-endemic setting = TRUE\n*/\ndefine \"Should Provide malaria prophylaxis\":\n  Config.\"Malaria-endemic setting\" = true"
