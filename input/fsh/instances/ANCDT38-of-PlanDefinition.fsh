* extension[=].extension[0].url = "libraryName"
* extension[=].extension[=].valueString = "ANCConfig"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "Population prevalence of soil-transmitted helminth infection"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n  Description: The percentage of individuals in the general population\n    infected with at least one species of soil-transmitted helminth\n*/\ndefine \"Population prevalence of soil-transmitted helminth infection\":\n  21 '%'"
