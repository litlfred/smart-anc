* extension[=].extension[=].valueString = "Population prevalence of tuberculosis (TB)"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\nDescription: The tuberculosis prevalence in the general population\n  in number of cases per 100 000 persons or greater\n*/\ndefine \"Population prevalence of tuberculosis (TB)\":\n  102"
* extension[=].extension[+].url = "displaySequence"
* extension[=].extension[=].valueInteger = 0
* extension[+].url = "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
* extension[=].extension[0].url = "libraryName"
* extension[=].extension[=].valueString = "ANCContactDataElements"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "HIV status"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n  @dataElement: ANC.B9.DE45 HIV status\n  @activity: ANC.B9 Lab tests & imaging\n  @description: Calculated field for woman's HIV status\n*/\ndefine \"HIV status\":\n  WC.Only(\n  [Observation: Cx.\"HIV status\"] O\n    where O.status in { 'final', 'amended', 'corrected' }\n      and Coalesce(WC.ModifierExtension(O, 'who-notDone').value, false) is false\n      and Last(Split(O.encounter.reference, '/')) = Last(Split(encounter, '/'))\n  ).value as FHIR.CodeableConcept"
* extension[=].extension[+].url = "displaySequence"
* extension[=].extension[=].valueInteger = 1
* extension[+].url = "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
* extension[=].extension[0].url = "libraryName"
* extension[=].extension[=].valueString = "ANCDT13"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "Should Conduct TB screening"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n(\"Population prevalence of tuberculosis (TB)\" ≥ 100 per 100 000 population)\n  OR (\"HIV status\" = \"HIV positive\")\n*/\ndefine \"Should Conduct TB screening\":\n  Config.\"Population prevalence of tuberculosis (TB)\" >= 100\n    or ContactData.\"HIV status\" in Cx.\"HIV status - HIV positive Choices\""
* extension[=].extension[+].url = "displaySequence"
* extension[=].extension[=].valueInteger = 2
* extension[+].url = "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
* extension[=].extension[0].url = "libraryName"
* extension[=].extension[=].valueString = "FHIRHelpers"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "ToConcept"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "define function ToConcept(concept FHIR.CodeableConcept):\n    if concept is null then\n        null\n    else\n        System.Concept {\n            codes: concept.coding C return ToCode(C),\n            display: concept.text.value\n        }"
* extension[=].extension[+].url = "displaySequence"
* extension[=].extension[=].valueInteger = 3
