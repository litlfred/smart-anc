* extension[=].extension[=].valueString = "ANCDT20"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "Should Conduct hepatitis C positive counselling"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n\"Hepatitis C test result\" = \"Hepatitis C positive\"\n*/\ndefine \"Should Conduct hepatitis C positive counselling\":\n  ContactData.\"Hepatitis C test result\" in Cx.\"Hepatitis C Test Result - Positive Choices\""
