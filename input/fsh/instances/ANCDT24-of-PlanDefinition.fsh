* extension[=].extension[=].valueString = "ANCContactDataElements"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "TB screening result"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n  @dataElement: ANC.B9.DE206 TB screening result\n  @activity: ANC.B9 Lab tests & imaging\n  @description: Record the result of the TB screening\n*/\ndefine \"TB screening result\":\n  WC.Only(\n  [Observation: Cx.\"TB screening result\"] O\n    where O.status in { 'final', 'amended', 'corrected' }\n      and Coalesce(WC.ModifierExtension(O, 'who-notDone').value, false) is false\n      and Last(Split(O.encounter.reference, '/')) = Last(Split(encounter, '/'))\n  ).value as FHIR.CodeableConcept"
* extension[=].extension[+].url = "displaySequence"
* extension[=].extension[=].valueInteger = 0
* extension[+].url = "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
* extension[=].extension[0].url = "libraryName"
* extension[=].extension[=].valueString = "ANCDT24"
* extension[=].extension[+].url = "name"
* extension[=].extension[=].valueString = "Should Conduct TB screening positive counseling"
* extension[=].extension[+].url = "statement"
* extension[=].extension[=].valueString = "/*\n\"TB screening result\" = \"Positive for TB\"\n*/\ndefine \"Should Conduct TB screening positive counseling\":\n  ContactData.\"TB screening result\" in Cx.\"TB Screening Result - Positive Choices\""
* extension[=].extension[+].url = "displaySequence"
* extension[=].extension[=].valueInteger = 1
* extension[+].url = "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition"
