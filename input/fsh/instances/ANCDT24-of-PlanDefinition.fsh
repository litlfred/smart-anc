* name = "ANCDT24"
* title = "ANC.DT.24 TB diagnosis"
* type = $plan-definition-type#eca-rule
* status = #active
* experimental = false
* date = "2025-06-24T13:58:48-06:00"
* description = "If the woman's TB screening results are positive for TB, provide the required treatment as per local TB protocols"
* useContext.code = $usage-context-type#task "Workflow Task"
* useContext.valueCodeableConcept = $activity-codes#ANC.B10.4. "Diagnosis and treatment"
* library = "http://smart.who.int/anc/Library/ANCDT24"
* action.title = "ANC.DT.24 TB diagnosis"
* action.trigger.type = #named-event
* action.trigger.name = "ANC.B10.4. Diagnosis and treatment"
* action.action.id = "1"
* action.action.title = "Conduct TB screening positive counseling"
* action.action.description = "Conduct TB screening positive counseling"
* action.action.textEquivalent = "Treat according to local protocol and/or refer for treatment.\n\"In settings where the tuberculosis (TB) prevalence in the general population is 100/100 000 population or higher, systematic screening for active TB should be considered for pregnant women as part of antenatal care\" (2)"
* action.action.documentation.type = #citation
* action.action.documentation.label = "WHO ANC recommendations (2016): B.1.8. Tuberculosis (TB) (3)"
* action.action.condition.kind = #applicability
* action.action.condition.expression.description = "\"TB screening result\" = \"Positive for TB\""
* action.action.condition.expression.language = #text/cql-identifier
* action.action.condition.expression.expression = "Should Conduct TB screening positive counseling"